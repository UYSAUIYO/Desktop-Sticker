.vs/
.mimosa/
.vscode/
x64/
Debug/
Release/
*.user
*.suo
*.ncb
*.sdf
*.opensdf
*.VC.db
*.VC.VC.opendb
*.ipch

# NuGet packages (restored)
packages/
*.nupkg

# C++/WinRT generated files
Generated Files/

# VS test results
TestResults/
*.coverage
*.trx

# NuGet/build caches
*.assets.cache
project.assets.json
project.nuget.cache

# MSIX package build output
AppPackages/
*.appx
*.msix
*.appxsym

# Build artifacts
bin/
obj/
out/
build/
# 临时探针/手工试跑的构建产物（如 probe 用的 .pck、样例工程）
build_tmp/
*.exe
*.dll
*.pdb
*.lib
*.exp
*.obj
*.ilk
*.log

# Windows
Thumbs.db
Desktop.ini

# User config
*.local

# Scene-wallpaper package exports (user data from the editor plugin / tests)
*.dswall
# 例外：仓库自带、供其他开发者复刻的示例 / 测试场景包（samples/README.md）。
!samples/*.dswall

# Godot editor import cache (regenerated on first open)
.godot/
# 例外：Wallpaper Studio 的工程**必须**随仓库带一个空的全类缓存（实施计划 §2.3 #6）。
# 不带它时引擎每次启动都会打印 "ERROR: Could not load global script class cache."。
!tools/wallpaper-studio/project/.godot/
!tools/wallpaper-studio/project/.godot/global_script_class_cache.cfg
# 例外：Studio 的 src/build 是源码目录（场景构造），不是构建产物 —— 上面的 build/ 会误伤。
# 真正的运行期构建目录是 tools/wallpaper-studio/project/build/，仍然忽略。
!tools/wallpaper-studio/project/src/build/
!tools/wallpaper-studio/project/src/build/**

# FFmpeg payload + build-time SDK (fetched by tools/prepare_ffmpeg.ps1, never committed)
tools/ffmpeg/
tools/ffmpeg-sdk/
# Godot runtime payload for the scene-wallpaper backend (collected by tools/build_godot.ps1, never committed)
tools/godot/
# Godot source fork is vendored in tools/godot-src/ (tracked);
# its build output is ignored by the source tree's own .gitignore.

# Vulkan compile-time headers + shader compiler (fetched/built by
# tools/prepare_vulkan.ps1 and tools/prepare_shaderc.ps1, never committed)
tools/vulkan-sdk/
tools/shaderc/
tools/glslang-src/

# Godot 工程缓存（probe / host harness 导出时生成，不提交）
tools/godot-host-test/probe/.godot/


