; Studio 的 Godot 工程配置。
; 跑它的是 fork 出来的 template_release 运行库，所以这里不能出现任何依赖编辑器构建的设置。

config_version=5

[accessibility]

; 关掉无障碍：Studio 自己创建主窗口，而 fork 里 AccessKit 的 Windows 子类化适配器
; 要求"窗口首次显示前"注册，窗口自建的路径不满足这个前提。
general/accessibility_support=0

[application]

config/name="桌面贴纸 · 壁纸编辑器"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7")

[display]

window/size/viewport_width=1440
window/size/viewport_height=900
window/size/resizable=true
window/size/min_width=1024
window/size/min_height=640

; 对话框（文件选择、确认框）走**内嵌子窗口**，不开第二个原生窗口。
; 原生子窗口会给同一台机器再建一条 Vulkan 交换链，本机的 NVIDIA 驱动在这条路径上
; 出现过"打开选择框后整窗未响应"的卡死（现场 dump 的主线程停在 nvoglv64 里）；
; 内嵌之后所有对话框都在主窗口里画，没有第二条交换链。编辑器本体也是这么做的。
window/subwindows/embed_subwindows=true

[rendering]

renderer/rendering_method="forward_plus"
; 窗口底色。不设的话没挂面板的区域会露出引擎默认的灰色，跟这套深色界面完全不搭。
environment/defaults/default_clear_color=Color(0.078, 0.082, 0.094, 1)
